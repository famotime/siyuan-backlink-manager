{
  "name": "siyuan-backlink-manager",
  "version": "0.9.1",
  "type": "module",
  "description": "渐进式展开反链上下文，让双链笔记最初承诺的那种自由，真正落到日常里。",
  "repository": "https://github.com/famotime/siyuan-backlink-manager",
  "homepage": "https://github.com/famotime/siyuan-backlink-manager",
  "author": "Quincy Zou",
  "license": "MIT",
  "scripts": {
    "make-link": "node  --no-warnings ./scripts/make_dev_link.js",
    "dev": "vite build --watch",
    "build": "vite build && node ./scripts/verify-package.mjs",
    "make-install": "vite build && node --no-warnings ./scripts/make_install.js",
    "release": "node ./release.js",
    "release:changelog": "node ./release.js --mode=changelog",
    "release:manual": "node ./release.js --mode=manual",
    "release:patch": "node ./release.js --mode=patch",
    "release:minor": "node ./release.js --mode=minor",
    "release:major": "node ./release.js --mode=major",
    "verify:package": "node ./scripts/verify-package.mjs",
    "changelog:extract": "node ./scripts/extract-changelog.mjs",
    "preinstall": "npx --yes only-allow pnpm"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tsconfig/svelte": "^4.0.1",
    "@types/node": "^20.3.0",
    "fast-glob": "^3.2.12",
    "glob": "^7.2.3",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.63.3",
    "siyuan": "1.0.6",
    "svelte": "^4.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^1.0.2",
    "vite-plugin-zip-pack": "^1.0.5",
    "jszip": "^3.10.1"
  },
  "packageManager": "pnpm@10.18.3"
}
